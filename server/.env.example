# Server Port
PORT=5000
NODE_ENV=production

# Client URL (For CORS)
CLIENT_ORIGIN=https://your-frontend-domain.vercel.app

# MongoDB Connection String (Atlas recommended)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/edunex?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=30d

# Redis Configuration (For BullMQ & Caching)
REDIS_URL=redis://default:<password>@your-redis-host.upstash.io:3306

# API Keys (Optional - AI Integration)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (Optional - If handling user avatars)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
